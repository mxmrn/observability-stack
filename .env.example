# Copy to .env and tune for the current machine (.env is not committed).
# Defaults target a laptop with 16 GB of RAM.

PROM_RETENTION_TIME=3d
PROM_RETENTION_SIZE=5GB
PROM_CPUS=1
PROM_MEMORY=1536M

TEMPO_RETENTION=72h
TEMPO_CPUS=1
TEMPO_MEMORY=1G

LOKI_CPUS=1
LOKI_MEMORY=1G

OTELCOL_CPUS=1
OTELCOL_MEMORY=1G
