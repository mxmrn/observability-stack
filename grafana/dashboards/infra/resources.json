{
  "uid": "resources",
  "title": "Resources: host & containers",
  "description": "Host (node-exporter) and container (cAdvisor) resources. The top row tells whether load test measurements can be trusted.",
  "tags": ["infra", "cadvisor"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "project", "label": "Project", "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(container_cpu_usage_seconds_total, project)", "refId": "v" },
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".+", "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "service", "label": "Service", "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(container_cpu_usage_seconds_total{project=~\"$project\"}, service)", "refId": "v" },
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".+", "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "Measurement validity", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "Host CPU", "description": "> 90%: we are hitting the machine's limit, not the service's; test results are unreliable.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 }] } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))" }]
    },
    {
      "type": "stat", "title": "Host memory", "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.92 }] } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes" }]
    },
    {
      "type": "stat", "title": "Observability stack: CPU (cores)", "description": "How much the monitoring itself consumes.",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 }] } }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{project=\"observability\"}[$__rate_interval]))" }]
    },
    {
      "type": "stat", "title": "Observability stack: memory", "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(container_memory_working_set_bytes{project=\"observability\"})" }]
    },
    {
      "type": "timeseries", "title": "Host CPU by mode", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 7 },
      "description": "iowait: waiting on disk; steal: on a VPS the hypervisor gives your cores to neighbours.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineWidth": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "legendFormat": "{{mode}}",
        "expr": "avg by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval]))" }]
    },
    {
      "type": "timeseries", "title": "Load average vs core count", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [
        { "matcher": { "id": "byName", "options": "cores" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
      ] },
      "targets": [
        { "refId": "A", "legendFormat": "load1", "expr": "node_load1" },
        { "refId": "B", "legendFormat": "load5", "expr": "node_load5" },
        { "refId": "C", "legendFormat": "cores", "expr": "count(node_cpu_seconds_total{mode=\"idle\"})" }
      ]
    },

    { "type": "row", "title": "Containers", "gridPos": { "x": 0, "y": 12, "w": 24, "h": 1 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "CPU (cores)", "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{project=~\"$project\", service=~\"$service\"}[$__rate_interval]))" }]
    },
    {
      "type": "timeseries", "title": "CPU throttling (% of CFS periods)", "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "description": "The container hit its cpus limit and the kernel pauses it until the end of the 100ms period. Directly hurts tail latency.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (rate(container_cpu_cfs_throttled_periods_total{project=~\"$project\", service=~\"$service\"}[$__rate_interval])) / sum by (name) (rate(container_cpu_cfs_periods_total{project=~\"$project\", service=~\"$service\"}[$__rate_interval]))" }]
    },
    {
      "type": "timeseries", "title": "Memory (working set): this is what is compared to the limit for OOMKill", "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (container_memory_working_set_bytes{project=~\"$project\", service=~\"$service\"})" }]
    },
    {
      "type": "timeseries", "title": "Memory / limit", "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "description": "Only containers with a memory limit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "custom": { "thresholdsStyle": { "mode": "line" } },
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.9 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (container_memory_working_set_bytes{project=~\"$project\", service=~\"$service\"}) / sum by (name) (container_spec_memory_limit_bytes{project=~\"$project\", service=~\"$service\"} > 0)" }]
    },
    {
      "type": "timeseries", "title": "Network: receive (+) / transmit (-)", "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "tx .*" }, "properties": [{ "id": "custom.transform", "value": "negative-Y" }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "legendFormat": "rx {{name}}", "expr": "sum by (name) (rate(container_network_receive_bytes_total{project=~\"$project\", service=~\"$service\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "tx {{name}}", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{project=~\"$project\", service=~\"$service\"}[$__rate_interval]))" }
      ]
    },
    {
      "type": "timeseries", "title": "OOM events", "gridPos": { "x": 12, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "drawStyle": "bars", "fillOpacity": 80 } }, "overrides": [] },
      "targets": [{ "refId": "A", "legendFormat": "{{name}}",
        "expr": "sum by (name) (increase(container_oom_events_total{project=~\"$project\", service=~\"$service\"}[$__rate_interval])) > 0" }]
    }
  ]
}
