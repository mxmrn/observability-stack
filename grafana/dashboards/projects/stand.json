{
  "uid": "stand-nodes",
  "title": "Stand: fake EVM nodes",
  "description": "The fake nodes of the stand project: where their chain head is, what they answer and how fast.",
  "tags": [
    "stand"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Blocks behind the network head",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "description": "A node can be perfectly healthy and still serve data minutes old. This is the failure a gateway that only watches error rates never notices.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service}}",
          "expr": "scalar(max(node_head_block{project=\"stand\"})) - node_head_block{project=\"stand\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Answers by outcome",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "description": "ok, not_synced (block not here yet), unknown_block, unknown_method, and the chaos verdicts: failed, rate_limited, overloaded, hang.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ok.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*failed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*rate_limited.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service}} {{outcome}}",
          "expr": "sum by (service, outcome) (rate(node_rpc_requests_total{project=\"stand\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency by method (p99 dots are exemplars: click -> trace)",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "Replayed from what the recorder measured against a real provider, minus the round trip to it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{method}}",
          "exemplar": false,
          "expr": "histogram_quantile(0.5, sum by (le, method) (rate(node_rpc_duration_seconds_bucket{project=\"stand\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p99 {{method}}",
          "exemplar": true,
          "expr": "histogram_quantile(0.99, sum by (le, method) (rate(node_rpc_duration_seconds_bucket{project=\"stand\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99 gzip cost",
          "exemplar": false,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(node_compress_duration_seconds_bucket{project=\"stand\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes produced vs bytes on the wire",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "A block with transactions is ~350 KB of JSON and ~65 KB after gzip: hex is an alphabet of 16 symbols and compresses 5x. The gap between the two lines is what compression saves; the CPU it costs is on the latency panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (rate(node_rpc_response_bytes_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "on the wire ({{encoding}})",
          "expr": "sum by (encoding) (rate(node_wire_bytes_total{project=\"stand\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests in flight",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "description": "Rises when the node is slower than the arrival rate. With max_concurrency set, requests above this line get 503.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{service}}",
          "expr": "node_inflight_requests{project=\"stand\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls per HTTP request",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "description": "Batching hides many calls behind one connection: one request can cost the node a hundred lookups.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "avg {{service}}",
          "expr": "sum by (service) (rate(node_rpc_batch_size_sum{project=\"stand\"}[$__rate_interval])) / sum by (service) (rate(node_rpc_batch_size_count{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "p99 {{service}}",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(node_rpc_batch_size_bucket{project=\"stand\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node CPU and memory",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 7
      },
      "description": "Rendering a 350 KB response is real work: this is where it shows up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "mem.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "cpu {{service}}",
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "mem {{service}}",
          "expr": "sum by (service) (container_memory_working_set_bytes{project=\"stand\"})"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Warnings and errors (expand a line -> Open trace)",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"stand\"} | json | level=~\"WARN|ERROR\""
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Chain branch per node",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "description": "The fork epoch counts how many times this node rewrote its tip. A step means a reorg; nodes with different epochs are on different branches and will disagree about the same block number.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "epoch {{service}}",
          "expr": "node_fork_epoch{project=\"stand\"}"
        },
        {
          "refId": "B",
          "legendFormat": "reorgs {{service}}",
          "expr": "node_reorgs_total{project=\"stand\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Subscriptions and what they lose",
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 16,
        "h": 7
      },
      "description": "Notifications pushed per second against notifications thrown away because a client could not keep up. Drops are a silent failure: the connection stays open and the client keeps waiting for data that was discarded here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "dropped.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(connections|subscriptions).*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{kind}} /s {{service}}",
          "expr": "sum by (service, kind) (rate(node_ws_notifications_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "dropped /s {{service}}",
          "expr": "sum by (service) (rate(node_ws_dropped_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "C",
          "legendFormat": "connections {{service}}",
          "expr": "node_ws_connections{project=\"stand\"}"
        },
        {
          "refId": "D",
          "legendFormat": "subscriptions {{kind}} {{service}}",
          "expr": "node_ws_subscriptions{project=\"stand\"} > 0"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider: compute units and refusals",
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 7
      },
      "description": "What the external provider charges us per second, by method, against what is left of the budget. Refusals are split by reason: throughput means slow down, budget means stop and degrade, range means the query was too wide to ever be served.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "budget left"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "refused.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "CU/s {{method}}",
          "expr": "sum by (method) (rate(provider_compute_units_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "refused {{reason}}",
          "expr": "sum by (reason) (rate(provider_rejected_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "C",
          "legendFormat": "budget left",
          "expr": "provider_budget_remaining{project=\"stand\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes on the wire, per proxy",
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 7
      },
      "description": "Measured by toxiproxy in the middle, so it belongs to neither side. A bandwidth toxic shows up here as a flat ceiling while both the node and the client still think they are fast.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{proxy}} {{direction}}",
          "expr": "sum by (proxy, direction) (rate(toxiproxy_proxy_sent_bytes_total[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load generator: completed vs dropped",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 7
      },
      "description": "Requests k6 completed per second against iterations it had to drop. A dropped iteration means the arrival rate could not be kept up: from that moment the numbers describe the generator or the queue in front of the service, not the service itself. Virtual users on the right axis show the queue piling up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dropped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "virtual users"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "completed",
          "expr": "sum(rate(k6_http_reqs_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "dropped",
          "expr": "sum(rate(k6_dropped_iterations_total{project=\"stand\"}[$__rate_interval]))"
        },
        {
          "refId": "C",
          "legendFormat": "virtual users",
          "expr": "max(k6_vus{project=\"stand\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load generator: latency by method, as the client sees it",
      "gridPos": {
        "x": 12,
        "y": 46,
        "w": 12,
        "h": 7
      },
      "description": "k6 sends durations to Prometheus in seconds, while its own console summary prints milliseconds - the same run reads 0.78 here and 780ms there. The client also pays for connection setup and for time spent queued before the handler starts, which no server-side metric can see.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p99 {{name}}",
          "expr": "max by (name) (k6_http_req_duration_p99{project=\"stand\"})"
        },
        {
          "refId": "B",
          "legendFormat": "p50 {{name}}",
          "expr": "max by (name) (k6_http_req_duration_p50{project=\"stand\"})"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Reorgs",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(node_fork_epoch{project=\"stand\"}[$__interval]) > 0",
        "step": "30s",
        "titleFormat": "reorg on {{service}}",
        "tagKeys": "service"
      }
    ]
  }
}